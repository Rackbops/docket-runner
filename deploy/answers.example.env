# docket-runner deployment answers -- the ONE operator-edited source of truth for a stack
# (research-triage#323's shape). Copy to the stack directory as answers.env (mode 600), fill it
# in, then `./rt render` writes .env (the compose half) and app.env (the container half) next to
# it. Values bare, no quotes; a value with spaces or # is written quoted by render.
#
# FORBIDDEN: ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, ANTHROPIC_BASE_URL. The runner runs on the
# Claude subscription only (CLAUDE_CODE_OAUTH_TOKEN below); render exits 2 if any of these
# appear here, even blank, and the runner refuses to start if one reaches its environment.

# --- Stack: read by compose and rt, never by the container ---
IMAGE=ghcr.io/rackbops/docket-runner
# An immutable published tag: a release's x.y.z (published without the v) or sha-<7> from a push
# to main. Required; no default, so a fresh stack never pulls a tag nothing published.
IMAGE_TAG=
# Host-side loopback publish of the health port, for `rt health` and a local Kuma probe.
HEALTH_PORT=8787

# --- Container: the runner's environment ---
# The Claude subscription credential: a `claude setup-token` result (one year). NOT an API key.
CLAUDE_CODE_OAUTH_TOKEN=
# city-hall's public hostname, reached through the edge.
CITY_HALL_URL=
# The usr-issued runner credential city-hall verifies (shape per Lepid-Labs/city-hall#9).
CITY_HALL_RUNNER_TOKEN=
# Cloudflare Access service token for city-hall's hostname; both or neither.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Per-Job wall clock for the CLI call, ms.
CLAUDE_TIMEOUT_MS=120000
# How often to ask city-hall for work when idle, ms.
POLL_INTERVAL_MS=1500
# Caps a Job inherits when it names none.
DEFAULT_MAX_TURNS=8
DEFAULT_MAX_BUDGET_USD=0.50
# Optional: `--model` when a Job names none (an alias like sonnet, or a full id).
DEFAULT_MODEL=
TZ=America/New_York
