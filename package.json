{
  "name": "docket-runner",
  "private": true,
  "version": "0.0.2",
  "description": "Runs Claude Code print-mode jobs for the docket task tracker. Claims Jobs from city-hall, runs claude -p as the Job says, posts the JobResult back. Holds the only Claude credential; never an API key.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rackbops/docket-runner.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "tsc && node scripts/check-no-runtime-deps.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run && node --test deploy/render.test.mjs spike/lib.test.mjs",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "start": "node dist/index.js",
    "spike": "node spike/run.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@rackbops/docket-core": "^0.5.0",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.0",
    "vitest": "^5.0.1"
  }
}
